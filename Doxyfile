PROJECT_NAME           = "webbridge"
OUTPUT_DIRECTORY       = doxygen
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
RECURSIVE              = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO

# Public API surface only: object.h / error.h and the two headers they alias
# (property<T>, event<Args...>). The rest of impl/ is implementation detail.
# Headers come from the webbridge-runtime git submodule checked out at vendor/.
INPUT                  = vendor/src/webbridge/object.h \
                          vendor/src/webbridge/error.h \
                          vendor/src/webbridge/impl/property_impl.h \
                          vendor/src/webbridge/impl/event_impl.h

JAVADOC_AUTOBRIEF       = YES
EXTRACT_ALL             = YES
